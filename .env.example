# DEMO defaults. In a shared deployment change the password in both
# POSTGRES_PASSWORD and DATABASE_URL, and use your own database volume.
EVALBOARD_DEMO=1
DATABASE_URL=postgresql+psycopg://evalboard:evalboard_demo@db:5432/evalboard
SESSION_COOKIE_SECURE=false
POSTGRES_USER=evalboard
POSTGRES_PASSWORD=evalboard_demo
POSTGRES_DB=evalboard
EVALBOARD_API_PORT=8010
# Optional connected adapters. No live call is made without configuration.
OPENAI_API_KEY=
HTTP_TARGET_ALLOWLIST=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=evalboard
